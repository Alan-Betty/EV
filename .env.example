# E.V. configuration. Copy this file to `.env` and fill in a key.
#   cp .env.example .env
# Every setting is optional except the API key for your chosen provider.

# =============================================================================
# BRAIN - pick one provider
# =============================================================================
# groq | gemini
EV_LLM_PROVIDER=groq

# Groq: free key at https://console.groq.com/keys
GROQ_API_KEY=
EV_GROQ_MODEL=llama-3.3-70b-versatile
# Groq's catalogue varies per account. If the model above is not available on
# yours, E.V. checks at startup and falls back down this list automatically.
# Run `python ev_core.py --check` to see which model you will actually get.
EV_GROQ_MODEL_FALLBACKS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant,qwen/qwen3.8-27b,groq/compound

# Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
EV_GEMINI_MODEL=gemini-2.5-flash

EV_LLM_TEMPERATURE=0.4
EV_LLM_MAX_TOKENS=400
EV_LLM_TIMEOUT_S=20
# Exchanges kept in context. Higher costs tokens and latency, not much else.
EV_HISTORY_TURNS=6
# Stream the completion so speech starts on the first finished sentence
# instead of after the last token. This is the single biggest latency win;
# turn it off only to debug. Falls back to a plain call automatically on
# any streaming error, so nothing is lost either way.
EV_LLM_STREAMING=true
# How much of a tool result is replayed to the model next turn. It goes in
# an input role, never the assistant role - see ev/brain.py for why.
EV_HISTORY_OBSERVATION_CHARS=400

# =============================================================================
# SPEECH RECOGNITION
# =============================================================================
# groq       - Groq Cloud Whisper. Fastest and most accurate. Needs GROQ_API_KEY.
# google     - SpeechRecognition's free Google endpoint. No key, less accurate.
# whispercpp - local whisper.cpp binary. Offline, but costs real RAM.
EV_STT_PROVIDER=groq
# large-v3 is more accurate than turbo on short commands; turbo is ~0.1s faster.
EV_GROQ_STT_MODEL=whisper-large-v3

# Whisper is conditioned on this text, which biases it towards words E.V.
# actually hears. Add your project names, tools and jargon - this is the
# cheapest fix for recurring misrecognitions.
EV_STT_VOCABULARY=E.V., Chrome, VS Code, Claude Code, GitHub, Notepad, PowerShell, Windows Terminal, git, npm, repo, standby, take five.
EV_STT_LANGUAGE=en

# --- decoding prompt -------------------------------------------------------
# Extend the vocabulary above with names from this machine: installed programs
# (read from the Start Menu), your user folders, open backlog items, and the
# previous utterance. A fixed list cannot know what you installed last week.
# This is the cheapest accuracy gain available - it is what stops a program
# name being rewritten into the nearest ordinary English word.
EV_STT_DYNAMIC_PROMPT=true
# Whisper's prompt window is about 224 tokens and it silently drops the front
# of anything longer, so the total is capped here.
EV_STT_PROMPT_MAX_CHARS=700

# --- confidence gate -------------------------------------------------------
# Whisper reports how sure it was of every segment. Ignoring that does not
# cost you a wrong word on screen - it costs you a wrong *action*, because a
# garbled transcript still gets handed to the model, which picks a tool and
# runs it. With the gate on, a bad transcript becomes "Didn't catch that".
# Only the groq backend reports confidence; the others are left alone.
EV_STT_CONFIDENCE_GATE=true
# Scale: clear speech lands around -0.15 to -0.45. Below the second value the
# model is told the words may be wrong; below the first, E.V. asks you to
# repeat instead of guessing. Lower both if it re-asks too often.
EV_STT_MIN_LOGPROB=-1.0
EV_STT_UNCERTAIN_LOGPROB=-0.6
# Whisper's own estimate that the audio was not speech at all.
EV_STT_MAX_NO_SPEECH=0.6
# Text that compresses this well is Whisper looping a phrase, not a sentence.
EV_STT_MAX_COMPRESSION=2.4

# Only for EV_STT_PROVIDER=whispercpp
# EV_WHISPER_CPP_BIN=whisper-cli
# EV_WHISPER_CPP_MODEL=models/ggml-tiny.en.bin

# =============================================================================
# VOICE OUTPUT (edge-tts)
# =============================================================================
EV_TTS_ENABLED=true
# Full list: python -m ev.tts_voices    (or: edge-tts --list-voices)
# Audition one:  python -m ev.tts_voices --demo en-US-AriaNeural
# Male:   en-US-GuyNeural (default), en-US-AndrewMultilingualNeural,
#         en-US-BrianMultilingualNeural, en-GB-RyanNeural (British)
# Female: en-US-AvaMultilingualNeural, en-US-AriaNeural (confident),
#         en-US-EmmaMultilingualNeural (warm), en-GB-SoniaNeural (British)
# Male:   en-US-GuyNeural, en-US-AndrewMultilingualNeural, en-GB-RyanNeural
EV_TTS_VOICE=en-US-GuyNeural
EV_TTS_RATE=+18%
EV_TTS_VOLUME=+0%
EV_TTS_PITCH=+0Hz
# Chunk size, NOT a truncation limit. Long replies are split on sentence
# boundaries and spoken in full - E.V. never drops words. Smaller means speech
# starts sooner.
EV_TTS_CHUNK_CHARS=180
# The opening chunk is kept short so speech starts sooner; synthesis time
# scales with length. Replies shorter than this are spoken in one piece.
EV_TTS_FIRST_CHUNK_CHARS=60
# Shortest streamed fragment worth synthesising alone. Below this the
# sentence is held back: "E.V." parses as a finished sentence, and paying a
# network round trip to say four characters is worse than waiting.
EV_TTS_STREAM_MIN_CHARS=12

# Stop speaking the moment you talk over E.V. On loudspeakers (where E.V.
# hears itself) raise EV_BARGE_IN_FRAMES or turn barge-in off.
EV_TTS_BARGE_IN=true
EV_BARGE_IN_FRAMES=8

# Cache short spoken replies on disk. "Standing by." then costs a file copy
# instead of a ~0.8s round trip to Microsoft.
EV_TTS_CACHE_ENABLED=true

# =============================================================================
# MICROPHONE AND VOICE ACTIVITY DETECTION
# =============================================================================
EV_SAMPLE_RATE=16000
EV_FRAME_MS=30
# Device index, or any substring of the device name. Blank uses the default.
EV_INPUT_DEVICE=

# Raise EV_VAD_THRESHOLD if E.V. keeps triggering on background noise;
# lower it if it never hears you. Ambient level is measured at startup, so
# this is only the floor.
EV_VAD_THRESHOLD=0.015
EV_VAD_NOISE_MULTIPLIER=3.0
EV_VAD_CALIBRATE_S=1.0
# The noise floor also drifts with the room while E.V. is idle; this caps it.
EV_VAD_MAX_FLOOR=0.12
# Level the utterance before upload. Markedly improves recognition accuracy.
EV_AUDIO_NORMALISE=true
EV_MIN_SPEECH_MS=200
# Silence before E.V. decides you have finished talking.
EV_SILENCE_HANG_MS=1000
EV_MAX_UTTERANCE_S=20

# =============================================================================
# WAKE PHRASE
# =============================================================================
# false = respond to everything it hears. Handy for testing, noisy in practice.
EV_WAKE_REQUIRED=true
EV_WAKE_PHRASES=ev,e.v.,e v,hey ev,hey e.v.,okay ev,yo ev
# How long a conversation stays open. Inside this window you can just talk -
# no "E.V." needed. The timer resets on every exchange, so a real back-and-forth
# never lapses mid-flow. Say "take five" to end it early.
EV_CONVERSATION_WINDOW_S=8
# In standby E.V. ignores everything but "wake up" and "goodbye". Anything
# longer than this is a conversation happening in the room, not someone trying
# to wake it, so it is dropped before it costs a transcription call.
# "E.V., wake up" is comfortably under two seconds.
EV_STANDBY_MAX_UTTERANCE_S=4

# =============================================================================
# TOOLS AND SAFETY
# =============================================================================
EV_ALLOW_SHELL=true
# Destructive-looking commands ask before running. Turning this off is unwise:
# a misheard word becomes an executed command.
EV_SHELL_CONFIRM_DESTRUCTIVE=true
# Confirm every command, not only risky ones.
EV_SHELL_CONFIRM_ALL=false
EV_SHELL_TIMEOUT_S=30

# --- stopping something already running ------------------------------------
# "Stop" used to do nothing once a tool was underway: the work sits on a
# worker thread, and a thread cannot be killed from outside. Cancellation is
# cooperative - the tool agrees to stop at a point where stopping is safe,
# between two files or two polls of a subprocess, never mid-write.
#
# A shell command is killed mid-run. A batch file operation finishes the file
# it is on and leaves the rest alone. Launching a program cannot be undone, so
# E.V. says so instead of claiming it stopped.
EV_CANCEL_ENABLED=true
# Tools faster than this never get a listener; opening the microphone for
# something that returns in a quarter of a second is pure overhead.
EV_CANCEL_LISTEN_AFTER_S=0.8
# How often a running command is checked for "are we still wanted". A cancel
# also wakes the wait early, so this is the worst case, not the usual one.
EV_SHELL_POLL_S=0.1
# Grace between asking a process to stop and killing it outright.
EV_SHELL_KILL_GRACE_S=2

# Blank uses the system default browser.
EV_DEFAULT_BROWSER=
EV_DEFAULT_SEARCH_ENGINE=google

# Where dev_workflow looks for projects, and where terminal_command starts.
EV_DEFAULT_PROJECT_DIR=
EV_VSCODE_CLI=code
EV_CLAUDE_CLI=claude
# Seconds to wait for VS Code before driving its integrated terminal.
EV_VSCODE_BOOT_S=6

# =============================================================================
# TERMINAL UI
# =============================================================================
# The UI is presentation only. Nothing it draws can reach the speaker, so none
# of these settings can change a single word E.V. says.
# true = no colour, no panels, no spinners. Also happens automatically when
# `rich` is not installed or stdout is redirected to a file.
EV_UI_PLAIN=false
# Animated [Listening...] / [Thinking...] / [Executing...] status spinners.
EV_UI_SPINNERS=true

# =============================================================================
# FILE MANAGEMENT
# =============================================================================
# Everything file_manager touches must sit under one of these roots. Blank
# means your user profile, which covers Desktop, Downloads and Documents while
# keeping a misheard command away from C:\Windows. Separate multiple roots
# with the OS path separator (';' on Windows, ':' elsewhere).
# Widen this deliberately - it is the main thing standing between a
# misrecognised word and your files.
EV_FILE_ROOTS=
# Where a new file goes when you name no folder. Blank means Documents.
EV_FILE_DEFAULT_DIR=
# Deleting and reorganising always ask first. Turning this off means a
# misheard "delete that" runs without a yes. Don't.
EV_FILE_CONFIRM_DELETE=true
# Send deletes to the Recycle Bin (needs `pip install send2trash`) so a
# mistaken yes is recoverable. Falls back to a permanent delete without it.
EV_FILE_USE_TRASH=true
# Cap on how much of a file is read back into the model's context.
EV_FILE_MAX_READ_CHARS=4000
# Refuse to act on more than this many files in one sweep, so "organise my
# Downloads" cannot run away with a home directory. This also caps the
# batch_copy / batch_move / batch_rename actions.
EV_FILE_MAX_BATCH=500


# =============================================================================
# IMMEDIATE ACKNOWLEDGEMENT
# =============================================================================
# Launching an app or walking a folder tree takes seconds, and silence for
# those seconds reads as "it didn't hear me" - so the user repeats themselves
# and now there are two commands in flight. E.V. says something first instead.
#
# It never costs the action anything: the phrase is spoken from a background
# task while the tool is already running on its own thread.
EV_ACK_ENABLED=true
# Wait this long before speaking. A tool that finishes in 200ms needs no
# "stand by", and the acknowledgement is cancelled before it ever starts.
# Raise it if E.V. feels chatty, lower it if it feels unresponsive.
EV_ACK_DELAY_S=0.35
# The pool it picks from, separated by '|'. These are spoken verbatim.
EV_ACK_PHRASES=On it, stand by.|Working on it.|On it.|Give me a second.|Stand by.


# =============================================================================
# PERSISTENT STATE: MEMORY AND BACKLOG
# =============================================================================
# Two small JSON files, written atomically so a power cut leaves the previous
# version intact rather than an unparseable one. Blank uses .cache/state.
EV_STATE_DIR=
EV_MEMORY_FILE=
EV_BACKLOG_FILE=

# Preferences, profile facts, and how long E.V. was off between runs.
EV_MEMORY_ENABLED=true
# Stored facts ride in the system prompt, so they cost tokens on every turn.
# This cap is what stops that growing without bound.
EV_MEMORY_MAX_ENTRIES=40
# How often "still alive" is written while running. Bounds how much of a
# session an unclean exit can lose, without writing a file per sentence.
EV_MEMORY_TOUCH_INTERVAL_S=30
# Gaps shorter than this get no "welcome back" - restarting E.V. twice in a
# minute should not be greeted like a homecoming. 900 = fifteen minutes.
EV_MEMORY_MIN_GAP_S=900

# The list of things left unfinished: interrupted confirmations, failed
# actions, and reminders you asked E.V. to keep. Read back on the next boot.
# Index every Start Menu shortcut, so E.V. can launch programs that were never
# added to PATH and were never written into APP_ALIASES. Cached in the state
# directory. Nothing shells out to `start` any more: for a name Windows cannot
# find, `start` pops a modal error dialog and blocks until it is dismissed.
EV_APP_INDEX_ENABLED=true
# How long the cache stays fresh. 86400 = one day.
EV_APP_INDEX_TTL_S=86400
# A name that misses rescans, but no more often than this - otherwise a name
# that genuinely does not exist walks the Start Menu on every attempt.
EV_APP_INDEX_RESCAN_S=60

EV_BACKLOG_ENABLED=true
EV_BACKLOG_MAX_ITEMS=50
# Log failed and abandoned actions automatically, so the list fills itself.
EV_BACKLOG_AUTOLOG=true
# Wiping the whole list asks first, like every other destructive action.
EV_BACKLOG_CONFIRM_CLEAR=true


# =============================================================================
# SCREEN PERCEPTION AND COMPUTER USE
# =============================================================================
# E.V. can look at the screen and drive the mouse and keyboard. The frame is
# never written to disk and never goes near a local model: it is grabbed into
# memory, downscaled, JPEG-encoded and posted to the same provider the brain
# uses. Needs `mss` and `pillow` installed; without them take_screenshot and
# screen_task say so rather than failing silently.
EV_VISION_ENABLED=true
# Defaults to whatever EV_LLM_PROVIDER is, so one key usually covers both.
# EV_VISION_PROVIDER=groq
# EV_GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# EV_GROQ_VISION_FALLBACKS=meta-llama/llama-4-maverick-17b-128e-instruct,llama-3.2-90b-vision-preview
# EV_GEMINI_VISION_MODEL=gemini-2.5-flash
# A 4K frame is 8 MB raw and buys nothing - the model reads a button just as
# well at 1280px, and the upload is a fifth of the size.
EV_VISION_MAX_WIDTH=1280
EV_VISION_JPEG_QUALITY=60
EV_VISION_TIMEOUT_S=30
# A step of a screen task is about to move the pointer, so it is worth more
# pixels than a casual "what's on my screen". Menu entries and sidebar file
# names are what get misread at 1280px, and they are what a task must click.
EV_VISION_TASK_MAX_WIDTH=1600
EV_VISION_TASK_JPEG_QUALITY=72
# A labelled grid drawn over the frame before it is sent. The model reads a
# coordinate off the ruler instead of estimating one by eye, which is the
# single biggest reason clicks land near a target rather than on it. A few
# milliseconds and a few KB; turn it off only to see what it was buying.
EV_VISION_GRID=true
EV_VISION_GRID_DIVISIONS=10
# A zoom is a second look at one rectangle, cropped before the downscale, so
# small text arrives at full resolution. This is how a 4K display gets read.
EV_VISION_ZOOM_MAX_WIDTH=1400

# Driving the real mouse and keyboard is the most dangerous thing E.V. does:
# there is no sandbox and no undo. Setting this false removes the tools
# entirely; it does not merely hide them from the model.
EV_COMPUTER_USE_ENABLED=true
# Anything that looks like a purchase, a sent message, a delete or a
# credential is held for a spoken yes. Turning this off means a misheard word
# can buy something. Don't.
EV_COMPUTER_CONFIRM_RISKY=true
# A pointer that teleports confuses applications that track hover state.
EV_COMPUTER_MOVE_DURATION_S=0.15
EV_COMPUTER_TYPE_INTERVAL_S=0.01
# How long the screen gets to settle before the loop looks again. Too short
# and it reads the state it just changed.
EV_COMPUTER_ACTION_PAUSE_S=0.45
# Text longer than this, or containing a character the keyboard layout has no
# key for, is pasted through the clipboard instead of typed. The user's own
# clipboard is put back afterwards.
EV_COMPUTER_PASTE_THRESHOLD=60
# Ceilings on one autonomous run. A vision loop without them is a robot that
# clicks forever on a page that never changes. Eight was enough for "mute
# Spotify in the volume mixer" and far too few for "open the project in VS
# Code, open run.ps1 and run it".
EV_SCREEN_TASK_MAX_STEPS=16
EV_SCREEN_TASK_TIMEOUT_S=180
# Actions the model may chain in one reply without looking again. Typing a
# line and pressing Enter needs no fresh frame between the two. Kept small:
# the whole argument for the loop is that the screen moves underneath you.
EV_SCREEN_TASK_MAX_BATCH=3
# How long a `wait` step watches for a window title to appear. Polling for
# the window beats sleeping for a guess in both directions.
EV_SCREEN_TASK_WAIT_S=12

# Web work goes through the DOM instead of the pixels: faster, and a CSS
# selector cannot miss by three pixels. Needs playwright installed.
EV_BROWSER_AUTOMATION_ENABLED=true
EV_BROWSER_ENGINE=chromium
# Headed by default - watching it happen is most of the reassurance.
EV_BROWSER_HEADLESS=false
EV_BROWSER_STEP_TIMEOUT_S=15
EV_BROWSER_TASK_TIMEOUT_S=90
EV_BROWSER_MAX_STEPS=20
# How much a `read` step may hand back, and how many matching elements it may
# return. An inbox is thirty rows, and reading only the first is how "give me
# a summary of the important mails" became a summary of one mail.
EV_BROWSER_READ_CHARS=2400
EV_BROWSER_READ_ITEMS=30
# Keep cookies between tasks, so a web errand starts signed in to whatever the
# user is signed in to. Without this every task reaches a login page and
# stops, which is what "open Gmail and summarise the important mail" does with
# a blank browser. Sign in once, in a window you can watch, and it holds.
# This is E.V.'s own profile, not your real Chrome one: Chrome locks its
# profile while it is running, and automating a live signed-in browser is a
# much bigger thing to hand a voice command.
EV_BROWSER_PERSIST_PROFILE=true
# Defaults to browser-profile inside EV_STATE_DIR.
# EV_BROWSER_PROFILE_DIR=

# Said before the first click rather than after it, with no delay: while a
# screen task runs the pointer moves on its own, and being told that is about
# to happen is the difference between "it is working" and "something has
# taken over my mouse".
EV_ACK_SCREEN_PHRASE=On it, navigating your screen.
EV_ACK_SCREEN_DELAY_S=0.0


# =============================================================================
# COMPOUND REQUESTS
# =============================================================================
# "Open my mail and give me a summary of the important things" is two jobs,
# and the model answers it with one tool call - it opens the mail and the
# summary never happens. When an utterance ends in a question the first tool
# cannot have answered, E.V. takes one more turn for it.
#
# Only a trailing question qualifies. "Open Chrome and search for X" is one
# call on purpose, and re-running the tail of that would search twice.
EV_CHAIN_ENABLED=true
# The first tool has usually just launched something. A screenshot taken
# before the window has drawn describes whatever was there before it.
EV_CHAIN_SETTLE_S=2.0

# Groq's free tier allows 8000 tokens a minute and one request with the full
# tool schema attached is about half of that, so a second request inside the
# same minute gets refused. Rather than telling the user to wait, E.V. waits
# out the window the response headers name and tries once more. 0 disables.
EV_LLM_RATE_LIMIT_RETRIES=1
# Past this, admit it instead - nobody stands at a microphone for a minute.
EV_LLM_RATE_LIMIT_MAX_WAIT_S=12


# =============================================================================
# RUNTIME
# =============================================================================
EV_LOG_LEVEL=INFO
# true = typed input instead of the microphone. Same as passing --text.
EV_TEXT_MODE=false

# =============================================================================
# PERSONALITY
# =============================================================================
# The entire persona is one string: SYSTEM_PROMPT in config.py. Override it
# wholesale here if you want a different character. The tone examples at the
# bottom of that prompt do most of the work.
# EV_SYSTEM_PROMPT=
