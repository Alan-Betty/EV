{
  "version": 1,
  "_doc": "Eye parameters per mood. 'eyes' applies to both eyes, 'left'/'right' override one (viewer's left). Angles and x offsets are outer-relative, so one value reads the same on both eyes: tilt>0 lifts the outer corner, lid_angle>0 drops the lid towards the nose (focus, anger), x>0 moves outwards. Anything not given falls back to 'defaults'. Ranges live in ev/face/expression.py.",

  "defaults": {
    "eye": {
      "open": 1.0,
      "width": 1.0,
      "height": 1.0,
      "roundness": 0.55,
      "tilt": 0.0,
      "lid_top": 0.0,
      "lid_angle": 0.0,
      "lid_bottom": 0.0,
      "pupil": 0.3,
      "x": 0.0,
      "y": 0.0
    },
    "face": {
      "gaze_x": 0.0,
      "gaze_y": 0.0,
      "roll": 0.0,
      "color": "#5ce1ff",
      "glow": 0.65,
      "bob": 0.0,
      "bob_hz": 0.0,
      "ring": 0.0,
      "ring_speed": 0.0,
      "pulse_hz": 0.0
    },
    "blink": { "interval_s": [2.8, 6.5], "double_chance": 0.15, "speed": 1.0 },
    "saccade": { "interval_s": [1.2, 3.5], "range": 0.18 },
    "track_cursor": false,
    "transition_ms": 160,
    "hold_s": 0
  },

  "moods": {
    "neutral": {},

    "idle": {
      "eyes": { "open": 0.9 },
      "face": { "glow": 0.5, "bob": 0.012, "bob_hz": 0.25 },
      "blink": { "interval_s": [3.5, 8.0] },
      "saccade": { "interval_s": [1.8, 4.5], "range": 0.35 },
      "track_cursor": true,
      "transition_ms": 400
    },

    "listening": {
      "eyes": { "height": 1.1, "pupil": 0.4, "roundness": 0.6 },
      "left": { "height": 1.16 },
      "face": { "roll": 7.0, "glow": 0.85, "pulse_hz": 0.6 },
      "blink": { "interval_s": [4.0, 9.0], "double_chance": 0.05 },
      "saccade": { "range": 0.05 },
      "track_cursor": true
    },

    "thinking": {
      "eyes": { "height": 0.85, "lid_bottom": 0.1, "pupil": 0.25 },
      "right": { "lid_top": 0.12, "lid_angle": -8.0 },
      "face": { "gaze_x": 0.55, "gaze_y": -0.55, "roll": -4.0, "glow": 0.75, "ring": 1.0, "ring_speed": 0.9, "pulse_hz": 1.1 },
      "blink": { "interval_s": [1.6, 3.2], "double_chance": 0.3 },
      "saccade": { "interval_s": [0.5, 1.2], "range": 0.12 },
      "transition_ms": 220
    },

    "focused": {
      "eyes": { "width": 1.06, "height": 0.8, "lid_top": 0.3, "lid_angle": 11.0, "roundness": 0.4, "pupil": 0.18 },
      "face": { "glow": 0.9, "ring": 0.7, "ring_speed": 0.5 },
      "blink": { "interval_s": [5.0, 10.0], "double_chance": 0.0 },
      "saccade": { "interval_s": [0.35, 0.9], "range": 0.1 }
    },

    "speaking": {
      "eyes": { "height": 1.02, "pupil": 0.34 },
      "face": { "glow": 0.8, "bob": 0.02, "bob_hz": 2.2 },
      "saccade": { "range": 0.08 }
    },

    "happy": {
      "eyes": { "height": 1.0, "lid_bottom": 0.58, "roundness": 0.9, "pupil": 0.0, "y": -0.03 },
      "face": { "color": "#7cf0d0", "glow": 1.0, "bob": 0.03, "bob_hz": 2.6 },
      "blink": { "interval_s": [6.0, 10.0] },
      "saccade": { "range": 0.0 },
      "transition_ms": 120,
      "hold_s": 1.8
    },

    "skeptical": {
      "left": { "height": 0.62, "lid_top": 0.35, "lid_angle": 14.0 },
      "right": { "height": 1.08, "y": -0.05 },
      "face": { "gaze_x": -0.35, "roll": -5.0 },
      "blink": { "interval_s": [3.0, 6.0], "double_chance": 0.0 },
      "saccade": { "range": 0.04 },
      "transition_ms": 260
    },

    "confused": {
      "left": { "height": 1.18, "y": -0.06, "tilt": 6.0 },
      "right": { "height": 0.74, "lid_top": 0.18, "lid_angle": -10.0, "y": 0.04 },
      "face": { "roll": 11.0, "gaze_y": -0.2 },
      "blink": { "interval_s": [0.9, 2.0], "double_chance": 0.45 },
      "saccade": { "interval_s": [0.4, 1.0], "range": 0.3 },
      "hold_s": 2.2
    },

    "surprised": {
      "eyes": { "width": 0.88, "height": 1.3, "roundness": 1.0, "pupil": 0.2 },
      "face": { "glow": 1.0, "gaze_y": -0.1 },
      "blink": { "interval_s": [6.0, 10.0], "double_chance": 0.0 },
      "saccade": { "range": 0.0 },
      "transition_ms": 70,
      "hold_s": 1.1
    },

    "sad": {
      "eyes": { "height": 0.8, "lid_top": 0.24, "lid_angle": -16.0, "y": 0.04 },
      "face": { "gaze_y": 0.45, "color": "#6fa8ff", "glow": 0.4 },
      "blink": { "interval_s": [2.0, 4.0], "speed": 0.7 },
      "saccade": { "range": 0.05 },
      "transition_ms": 450,
      "hold_s": 2.5
    },

    "sleepy": {
      "eyes": { "open": 0.22, "lid_top": 0.2, "lid_angle": -6.0, "roundness": 0.8, "pupil": 0.0 },
      "face": { "gaze_y": 0.3, "glow": 0.25, "color": "#3d8fb0", "bob": 0.015, "bob_hz": 0.18 },
      "blink": { "interval_s": [5.0, 9.0], "double_chance": 0.0, "speed": 0.35 },
      "saccade": { "range": 0.0 },
      "transition_ms": 900
    },

    "alert": {
      "eyes": { "width": 1.05, "height": 0.86, "lid_top": 0.22, "lid_angle": 17.0, "roundness": 0.3, "pupil": 0.0 },
      "face": { "color": "#ff3b30", "glow": 1.0, "ring": 1.0, "ring_speed": 1.8, "pulse_hz": 2.0 },
      "blink": { "interval_s": [8.0, 12.0], "double_chance": 0.0 },
      "saccade": { "range": 0.0 },
      "transition_ms": 60
    }
  },

  "events": {
    "idle": "idle",
    "wake": "listening",
    "listening": "listening",
    "transcribing": "thinking",
    "thinking": "thinking",
    "speaking": "speaking",
    "tool": "focused",
    "screen": "focused",
    "confirm": "skeptical",
    "success": "happy",
    "error": "sad",
    "misheard": "confused",
    "barge_in": "surprised",
    "poke": "surprised",
    "standby": "sleepy",
    "lockdown": "alert"
  }
}
